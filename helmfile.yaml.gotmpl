environments:

  dev:
    values:
      - namespace: devops-shop

  staging:
    values:
      - namespace: devops-shop-staging

  prod:
    values:
      - namespace: devops-shop-prod

---

repositories:
  - name: traefik
    url: https://traefik.github.io/charts

  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

helmDefaults:
  wait: true
  timeout: 300
  createNamespace: true


releases:

  - name: traefik
    namespace: traefik
    chart: traefik/traefik
    version: "40.2.0"
    values:
     - release-values/traefik.yaml
    labels:
      layer: platform
      component: edge
    
  - name: monitoring
    namespace: monitoring
    chart: prometheus-community/prometheus
    version: "29.24.0"
    values:
     - release-values/monitoring.yaml
    labels:
      layer: observability
      component: monitoring

  - name: shopstack
    namespace: {{ .Values.namespace }}
    chart: ./charts/shop-stack
    values:
      - environments/{{ .Environment.Name }}.yaml
    labels:
      layer: application
      component: shop
    needs:
     - traefik/traefik #Namespace + release name